{
  "name": "sink-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run guard:bundle",
    "preview": "vite preview",
    "test": "vitest run && npm run guard:production",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --build --force",
    "guard:production": "node scripts/guard-production.mjs",
    "guard:bundle": "node scripts/guard-production.mjs --dist",
    "verify": "npm test && npm run build"
  },
  "dependencies": {
    "@lucide/vue": "1.35.0",
    "@vueuse/core": "14.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "reka-ui": "2.10.4",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vue": "3.5.42",
    "vue-sonner": "2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "jsdom": "27.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
